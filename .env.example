# Copy to .env.local for the Next.js app, and set the Convex
# dashboard equivalents for backend functions and HTTP routes.
# Never commit real secrets. Placeholder values let `npm test` and
# `npm run build` run without live accounts.

# --- Clerk (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Issuer domain used by Convex to validate Clerk JWTs, e.g. https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=https://placeholder.clerk.accounts.dev

# --- Convex ---
# From `npx convex dev` once you are signed in to Convex.
NEXT_PUBLIC_CONVEX_URL=https://placeholder.convex.cloud
# Public HTTP site URL for n8n to call (Convex dashboard → Settings → URL).
# Looks like https://<deployment>.convex.site
CONVEX_SITE_URL=https://placeholder.convex.site

# --- Shared HMAC secret (Convex env + n8n env + any local scripts) ---
# Generate with: openssl rand -hex 32
LENDLOOP_WEBHOOK_SECRET=replace-with-a-long-random-secret

# --- n8n ---
# Production webhook URL from n8n after you import and activate the
# request-notification workflow (see README).
N8N_REQUEST_WEBHOOK_URL=http://localhost:5678/webhook/lendloop-request
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
# Optional basic auth for the n8n editor UI
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# --- Access control ---
# Comma-separated Clerk user IDs that should be granted the admin role
# on first sign-in. Set this in the Convex dashboard environment, not only in .env.local.
ADMIN_CLERK_USER_IDS=

# --- Optional ---
# When Convex is not configured, set this to "1" to render clearly
# labelled sample tools on the public page (preview only).
NEXT_PUBLIC_PREVIEW_FIXTURES=0
